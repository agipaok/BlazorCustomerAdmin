@inherits LayoutComponentBase
@using MudBlazor

<MudDialogProvider />
<MudSnackbarProvider />
<MudPopoverProvider />

<MudLayout>
    <MudAppBar Color="Color.Primary" Fixed="true" Dense="true">
        <MudText Typo="Typo.h6">Customer Admin</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Fixed="true" Variant="DrawerVariant.Mini"
               ClipMode="DrawerClipMode.Always">
        <NavMenu />
    </MudDrawer>

    <MudMainContent Class="pt-16 px-4">
        @Body
    </MudMainContent>
</MudLayout>