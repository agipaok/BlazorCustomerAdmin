@using MudBlazor
@using BlazorApp.Client.Models

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Edit Customer</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="Customer.CompanyName" Label="Company Name" />
        <MudTextField @bind-Value="Customer.ContactName" Label="Contact Name" />
        <MudTextField @bind-Value="Customer.Address" Label="Address" />
        <MudTextField @bind-Value="Customer.City" Label="City" />
        <MudTextField @bind-Value="Customer.Region" Label="Region" />
        <MudTextField @bind-Value="Customer.PostalCode" Label="Postal Code" />
        <MudTextField @bind-Value="Customer.Country" Label="Country" />
        <MudTextField @bind-Value="Customer.Phone" Label="Phone" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Save">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public Customer Customer { get; set; } = new();

    private void Cancel() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(Customer));
}