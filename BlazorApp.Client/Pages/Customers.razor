@page "/customers"
@rendermode InteractiveServer
@inject HttpClient Http
@inject IDialogService DialogService

@using BlazorApp.Client.Models
@using MudBlazor

<PageTitle>Customers</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">
    Customers Admin Panel
</MudText>

<MudButton Variant="Variant.Filled"
           Color="Color.Success"
           Class="mb-4"
           OnClick="OpenCreateDialog">
    Add Customer
</MudButton>

<MudPaper Class="pa-4">
    <MudTable @ref="table"
              ServerData="LoadServerData"
              Hover="true"
              Dense="true">
        <HeaderContent>
            <MudTh>Company</MudTh>
            <MudTh>Contact</MudTh>
            <MudTh>City</MudTh>
            <MudTh>Phone</MudTh>
            <MudTh>Actions</MudTh>
        </HeaderContent>

        <RowTemplate>
            <MudTd>@context.CompanyName</MudTd>
            <MudTd>@context.ContactName</MudTd>
            <MudTd>@context.City</MudTd>
            <MudTd>@context.Phone</MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                               Color="Color.Primary"
                               OnClick="@(() => OpenEditDialog(context))" />

                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                               Color="Color.Error"
                               OnClick="@(() => DeleteCustomer(context.Id))" />
            </MudTd>
        </RowTemplate>

        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
</MudPaper>

@code {
    private MudTable<Customer> table = default!;

    private async Task<TableData<Customer>> LoadServerData(TableState state, CancellationToken token)
    {
        var page = state.Page + 1;
        var pageSize = state.PageSize;

        var result = await Http.GetFromJsonAsync<PagedResult<Customer>>(
            $"api/customers?page={page}&pageSize={pageSize}", token);

        return new TableData<Customer>
        {
            Items = result?.Items ?? new(),
            TotalItems = (int)(result?.TotalCount ?? 0)
        };
    }

    private async Task DeleteCustomer(string? id)
    {
        if (string.IsNullOrEmpty(id))
            return;

        bool? result = await DialogService.ShowMessageBoxAsync(
            new MessageBoxOptions
            {
                Title = "Επιβεβαίωση Διαγραφής",
                Message = "Είστε σίγουροι ότι θέλετε να διαγράψετε αυτόν τον πελάτη;",
                YesText = "Διαγραφή",
                CancelText = "Ακύρωση"
            });
        if (result !=true)
            return;

        await Http.DeleteAsync($"api/customers/{id}");
        await table.ReloadServerData();
    }

    private async Task OpenEditDialog(Customer customer)
    {
        var parameters = new DialogParameters<CustomerEditDialog>
        {
            { x => x.Customer, new Customer
                {
                    Id = customer.Id,
                    CompanyName = customer.CompanyName,
                    ContactName = customer.ContactName,
                    Address = customer.Address,
                    City = customer.City,
                    Region = customer.Region,
                    PostalCode = customer.PostalCode,
                    Country = customer.Country,
                    Phone = customer.Phone
                }
            }
        };

        var dialog = await DialogService.ShowAsync<CustomerEditDialog>("Edit Customer", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Customer edited)
        {
            await Http.PutAsJsonAsync($"api/customers/{edited.Id}", edited);
            await table.ReloadServerData();
        }
    }

    private async Task OpenCreateDialog()
    {
        var parameters = new DialogParameters<CustomerEditDialog>
        {
            { x => x.Customer, new Customer() }
        };

        var dialog = await DialogService.ShowAsync<CustomerEditDialog>("New Customer", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is Customer newCustomer)
        {
            await Http.PostAsJsonAsync("api/customers", newCustomer);
            await table.ReloadServerData();
        }
    }
}